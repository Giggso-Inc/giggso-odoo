ODOO_URL=https://odoo.example.com
ODOO_MCP_CONNECTOR_SECRET=replace-with-shared-connector-signing-secret
ODOO_MCP_IDENTITY_ISSUER=https://idp.example.com
ODOO_MCP_IDENTITY_AUDIENCE=odoo-mcp
ODOO_MCP_IDENTITY_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Optional local/staging fallback when JWKS URL is not configured:
# ODOO_MCP_IDENTITY_TOKEN_SECRET=replace-with-sso-gateway-token-secret
ODOO_MCP_AUDIT_LOG=/var/log/odoo-mcp/audit.jsonl
ODOO_MCP_TRANSPORT=streamable-http
ODOO_MCP_HOST=0.0.0.0
ODOO_MCP_PORT=8443
ODOO_MCP_BIND=0.0.0.0
ODOO_MCP_PUBLIC_URL=https://127.0.0.1:8443
ODOO_MCP_TLS_CERT_FILE=/run/odoo-mcp/certs/tls.crt
ODOO_MCP_TLS_KEY_FILE=/run/odoo-mcp/certs/tls.key
