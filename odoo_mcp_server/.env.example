# ─────────────────────────────────────────────────────────────────────
# Odoo MCP server — example environment file
#
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Version: 0.2.0 (Cycle 2.1)
# ─────────────────────────────────────────────────────────────────────


# ── Odoo connection ──────────────────────────────────────────────────
# Where this MCP server reaches Odoo over XML-RPC. Must be the URL that
# the EC2 host itself can hit; for the production setup that's the
# public domain because Odoo lives behind nginx on the same box.
ODOO_URL=https://odoo.example.com

# Database name. Required for the browser Odoo-login flow and as the
# default for the headless /auth/issue-token endpoint.
ODOO_DB_NAME=


# ── Shared signing secret ────────────────────────────────────────────
# HS256 secret used to sign session JWTs in BOTH flows:
#   - browser cookie flow  (oauth_token.mint_session_token)
#   - headless bearer flow (bearer_store.mint_long_token)
# Also the HMAC key for the Odoo addon's /odoo_mcp/action endpoint.
# Rotate by updating Odoo's `odoo_mcp_connector.signing_secret` system
# parameter to match this value.
ODOO_MCP_CONNECTOR_SECRET=replace-with-shared-connector-signing-secret


# ── Identity verifier (JWKS or local secret) ─────────────────────────
# Production: point at your IdP's JWKS. The verifier validates Google
# ID tokens (callback flow) against this.
ODOO_MCP_IDENTITY_ISSUER=https://idp.example.com
ODOO_MCP_IDENTITY_AUDIENCE=odoo-mcp
ODOO_MCP_IDENTITY_JWKS_URL=https://idp.example.com/.well-known/jwks.json

# Local/staging fallback when JWKS is not reachable. Leave empty in prod.
# ODOO_MCP_IDENTITY_TOKEN_SECRET=replace-with-sso-gateway-token-secret


# ── Optional Google OAuth (SSO) ──────────────────────────────────────
# Only needed if you want the "Sign in with Google" button. Without it,
# the Odoo login form and the headless bearer flow still work.
# ODOO_MCP_GOOGLE_CLIENT_ID=


# ── Transport + binding ──────────────────────────────────────────────
# Set TRANSPORT=sse to run the HTTP server (required for Claude Desktop).
# stdio is for direct local MCP clients.
ODOO_MCP_TRANSPORT=sse

# When nginx fronts TLS (recommended — see docs/clients/nginx-tls.md):
#   HOST=127.0.0.1, PORT=8443, leave TLS_CERT/KEY blank.
# When running uvicorn directly with self-signed cert (curl only):
#   HOST=0.0.0.0, PORT=8443, set TLS_CERT_FILE and TLS_KEY_FILE.
ODOO_MCP_HOST=127.0.0.1
ODOO_MCP_PORT=8443
ODOO_MCP_BIND=127.0.0.1

# TLS files. Leave blank when nginx terminates TLS upstream.
# ODOO_MCP_TLS_CERT_FILE=/home/opc/gg-odoo-app/domaincert/nginx.crt
# ODOO_MCP_TLS_KEY_FILE=/home/opc/gg-odoo-app/domaincert/nginx.key


# ── Public-facing URL ────────────────────────────────────────────────
# Must match what Claude Desktop hits and what the JWT iss/aud claims
# encode. For the path-based nginx topology this is the /mcp subpath.
ODOO_MCP_PUBLIC_URL=https://odoo.example.com/mcp


# ── Audit log ────────────────────────────────────────────────────────
# JSONL file the dispatcher appends to on every tool call. Mirror of
# the Odoo-side audit log; rotate with logrotate.
ODOO_MCP_AUDIT_LOG=/var/log/odoo-mcp/audit.jsonl
